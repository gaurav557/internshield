# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/internshield?schema=public"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Optional: set an email/password for a seeded administrator
ADMIN_EMAIL="admin@internshield.local"
ADMIN_PASSWORD="ChangeMe123!"
# Optional AI provider integration. Without these, transparent rule-based scoring is used.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
